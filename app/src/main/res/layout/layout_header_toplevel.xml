<?xml version="1.0" encoding="utf-8"?>
<!-- Строка 1 новой шапки (roadmap, "Новая шапка + единый Settings", п.3-4, косметика по
     образцу референса Bethesda) — переключатель верхнего уровня STATS/ITEMS/DATA/RADIO +
     иконка Settings слева + индикатор BLE справа. Пункты прибиты влево (не растянуты на
     всю ширину, как было раньше). Линия под пунктами — одна сплошная, во всю ширину
     экрана, от левого края до BLE-индикатора справа (не короткие сегменты между
     кнопками). Один общий инстанс на всё приложение, не по копии на раздел. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_header_toplevel"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <ImageView
        android:id="@+id/img_header_line"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="1.5dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bottom_linking_line" />

    <ImageView
        android:id="@+id/btn_header_settings"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.06"
        app:srcCompat="@drawable/ic_settings_gear" />

    <LinearLayout
        android:id="@+id/layout_header_menu_cluster"
        android:layout_width="wrap_content"
        android:layout_height="0.0dip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_header_settings"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_header_stats"
            style="@style/BottomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:minHeight="0.0dip"
            android:text="@string/title_stats" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_header_items"
            style="@style/BottomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:minHeight="0.0dip"
            android:text="@string/title_items" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_header_data"
            style="@style/BottomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:minHeight="0.0dip"
            android:text="@string/title_data" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- RADIO (roadmap, "Новая шапка + единый Settings", п.4) — 4-й раздел верхнего
             уровня, выносится из второго уровня DATA. У него уже есть свой аппаратный вход
             (физический тумблер, RADIOPWR от ESP32), тач по этой кнопке — второй,
             равноценный способ. У раздела нет строки 2. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_header_radio"
            style="@style/BottomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:minHeight="0.0dip"
            android:text="@string/title_radio" />

    </LinearLayout>

    <ImageView
        android:id="@+id/img_header_ble_status"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/bluetooth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.06"
        app:srcCompat="@drawable/ic_ble_status" />

</androidx.constraintlayout.widget.ConstraintLayout>

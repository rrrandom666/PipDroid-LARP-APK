<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/pip_background_darker"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayoutMain"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <!-- Новая шапка (roadmap, "Новая шапка + единый Settings", п.3) — было 10% экрана
             под одну строку (имя раздела + живые данные вперемешку), стало 20% под две
             строки: row1 (верхний уровень, общий инстанс) + row2 (второй уровень, те же
             три инстанса, что и раньше, просто переехали сюда с низа экрана). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_constraintLayout"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:minHeight="48dip"
            app:layout_constraintEnd_toEndOf="@id/main_constraintLayout"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintStart_toStartOf="@id/main_constraintLayout"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row1_constraintLayout"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <include
                    android:id="@+id/inc_layout_header_toplevel"
                    layout="@layout/layout_header_toplevel"
                    android:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row2_constraintLayout"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/row1_constraintLayout">

                <!-- Косметика по образцу референса (roadmap, "Новая шапка + единый
                     Settings"): второй уровень теперь один общий инстанс без рамки/полосы,
                     см. layout_header_row2.xml и setupRow2()/renderRow2() в
                     MainActivity.kt. Три инстанса ниже остаются в дереве НАВСЕГДА GONE —
                     их кнопки нужны только как источник текста/performClick() для
                     Row2Item, реальную логику переключения экрана трогать не пришлось. -->
                <include
                    android:id="@+id/inc_layout_header_row2"
                    layout="@layout/layout_header_row2"
                    android:visibility="visible" />

                <include
                    android:id="@+id/inc_layout_tab_stats_bottom"
                    layout="@layout/layout_tab_stats_bottom"
                    android:visibility="gone" />

                <include
                    android:id="@+id/inc_layout_tab_items_bottom"
                    layout="@layout/layout_tab_items_bottom"
                    android:visibility="gone" />

                <include
                    android:id="@+id/inc_layout_tab_data_bottom"
                    layout="@layout/layout_tab_data_bottom"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Нижняя контекстная панель (roadmap, там же) — один общий инстанс на все
             разделы STATS/ITEMS/DATA/RADIO (имя игрока/регион/дата/время/радиация, см.
             layout_header_bottom_common.xml) — на полигонной игре нет ни хитпойнтов, ни
             уровней, ни AP/XP, поэтому STATS больше не выделяется отдельной панелью.
             Высота увеличена с 0.06 до 0.08 (roadmap, локализация — замена шрифта на IBM
             Plex Mono Bold): межстрочный интервал у него примерно на 8% больше, чем был у
             Monofonto, в прежние 6% текст (имя/регион/дата/время/радиация) уже не помещался
             и обрезался нижним краем экрана — над панелью в STATS/ITEMS/DATA достаточно
             свободного места, чтобы забрать его без ужимания основного контента. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_constraintLayout"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:minHeight="48dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.08"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/inc_layout_header_bottom_common"
                layout="@layout/layout_header_bottom_common"
                android:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_constraintLayout"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toTopOf="@id/bottom_constraintLayout"
            app:layout_constraintEnd_toEndOf="@id/bottom_constraintLayout"
            app:layout_constraintStart_toStartOf="@id/bottom_constraintLayout"
            app:layout_constraintTop_toBottomOf="@id/title_constraintLayout">

            <LinearLayout
                android:id="@+id/tab_linearLayout"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@android:id/tabcontent"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">

                    <include
                        android:id="@+id/inc_layout_filter_modification"
                        layout="@layout/layout_filter_modification"
                        android:visibility="gone" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_stats"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <include
                            android:id="@+id/inc_layout_tab_stats_status"
                            layout="@layout/layout_tab_stats_status"
                            android:visibility="visible" />

                        <include
                            android:id="@+id/inc_layout_tab_stats_special"
                            layout="@layout/layout_tab_stats_special"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_stats_skills"
                            layout="@layout/layout_tab_stats_skills"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_stats_perks"
                            layout="@layout/layout_tab_stats_perks"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_stats_general"
                            layout="@layout/layout_tab_stats_general"
                            android:visibility="gone" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Weapons/Apparel/Aid/Misc/Ammo удалены (roadmap, этап 6, п.1) — были
                         игровыми Fallout-механиками, не нужны на полигонной игре. Map (п.2,
                         переехал из DATA/Local Map), Clock (п.3, переехал из списка
                         радиостанций RADIO, был попапом — теперь обычный раздел), Journal
                         (п.4, заглушка "Раздел находится в разработке"). -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_items"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <include
                            android:id="@+id/inc_layout_tab_items_map"
                            layout="@layout/layout_tab_items_map"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_items_clock"
                            layout="@layout/layout_tab_items_clock"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_items_journal"
                            layout="@layout/layout_tab_items_journal"
                            android:visibility="gone" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_data"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <include
                            android:id="@+id/inc_layout_tab_data_misc"
                            layout="@layout/layout_tab_data_misc"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_data_holotapes"
                            layout="@layout/layout_tab_data_holotapes"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/inc_layout_tab_data_radio"
                            layout="@layout/layout_tab_data_radio"
                            android:visibility="gone" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </FrameLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/img_scanline"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/scanline_xml" />

    <ImageView
        android:id="@+id/img_screenglare"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/screenglare_alpha"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fl_flashlight"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- POWER état-машина (протокол, раздел 3.1): по умолчанию видим — стартовое
         состояние приложения OFF, пока не пришёл первый POWER от ESP32. -->
    <View
        android:id="@+id/view_power_off"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@android:color/black"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Анимация включения (roadmap, "Видение приложения", п.11) — поверх view_power_off,
         показывается на время playBootSequence() при реальном POWER:1, потом прячется
         целиком, открывая уже готовый интерфейс под ней. -->
    <include
        android:id="@+id/inc_layout_boot_sequence"
        layout="@layout/layout_boot_sequence"
        android:visibility="gone" />

    <!-- Мастер настройки PipBoy 2000/3000 (roadmap, "Видение приложения"): регулировка
         рабочей области поверх тёмного экрана, потом подсказка про подключение железа.
         Видим только в режиме PipBoy, поверх view_power_off. -->
    <include
        android:id="@+id/inc_layout_pipboy2000_wizard"
        layout="@layout/layout_pipboy2000_wizard"
        android:visibility="gone" />

    <!-- Единый экран Settings (roadmap, "Новая шапка + единый Settings") — раньше было три
         независимые копии (по одной на STATS/ITEMS/DATA), теперь один инстанс поверх
         текущего экрана, как мод-селект/мастер. -->
    <include
        android:id="@+id/inc_layout_settings_global"
        layout="@layout/layout_tab_settings"
        android:visibility="gone" />

    <!-- Экран выбора режима (roadmap, "Видение приложения", п.1) — показывается первым
         при каждом запуске, до STATS/ITEMS/DATA. -->
    <include
        android:id="@+id/inc_layout_tab_mode_select"
        layout="@layout/layout_tab_mode_select"
        android:visibility="visible" />

    <!-- Дисклеймер (roadmap, "Дисклеймер при запуске — UX-спецификация") — переиспользует
         старый Welcome-экран Tutorial. Последний ребёнок root ConstraintLayout после
         мод-селекта — перекрывает буквально всё остальное, включая мод-селект, пока не
         закрыт кнопкой [Пропустить] (см. MainActivity.kt). На весь экран (не 96%-вставка,
         как раньше) — иначе мод-селект под ним торчит по краям, где заканчиваются линии
         шапки/футера. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayoutTutorial"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:visibility="gone"
        android:background="@color/pip_background_darker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/inc_layout_tab_tutorial_base"
            layout="@layout/layout_tab_tutorial_base"
            android:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Оверлей глитч-эффекта (roadmap, "Видение приложения", п.11 — довесок к анимации
         включения) — последний ребёнок root, перекрывает вообще всё (заставку и основной
         интерфейс), пока идёт короткий импульс. См. MainActivity.triggerGlitchPulse(). -->
    <ImageView
        android:id="@+id/iv_glitch_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/inc_layout_clock_fired_overlay"
        layout="@layout/layout_clock_fired_overlay" />

</androidx.constraintlayout.widget.ConstraintLayout>
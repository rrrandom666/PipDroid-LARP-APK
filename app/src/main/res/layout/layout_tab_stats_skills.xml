<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_stats_skills"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <!-- Единый компонент бокового меню 3 уровня (roadmap) — SidebarMenuAdapter вместо 13
         вручную скопированных ConstraintLayout-блоков. id scroll_tab_skills сохранён
         (на него ссылается applyScrollBar()/setScrollbarThumbDrawable() в MainActivity.kt,
         типизировано как View — RecyclerView подходит так же, как ScrollView). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scroll_tab_skills"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
        android:scrollbars="vertical"
        android:verticalScrollbarPosition="left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.925"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.425" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tab_skill_descriptions"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/scroll_tab_skills"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_skill_selected"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toTopOf="@id/layout_tab_skill_descriptions_text"
            app:layout_constraintEnd_toStartOf="@id/layout_skill_value_buttons"
            app:layout_constraintHeight_percent="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/skills_barter" />

        <!-- Кнопки +/- редактирования значения Skills (roadmap, "Финализация STATS") —
             действуют на выбранный навык (selectedSKILL), заменяют долгий тап по строке
             в списке слева. Узкая колонка справа от картинки, той же высоты (верхние 40%
             правой колонки), ниже (зона описания) не занимают. Разгон при удержании —
             как раньше у строки (интервал 500мс→50мс), у SPECIAL разгона нет. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_skill_value_buttons"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="6.0dip"
            app:layout_constraintBottom_toTopOf="@id/layout_tab_skill_descriptions_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.09">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_skill_increase"
                style="@style/PipWizardButtonStyle"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_marginBottom="4.0dip"
                android:text="+"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingLeft="2dip"
                android:paddingRight="2dip"
                android:paddingTop="0dip"
                android:paddingBottom="0dip"
                app:layout_constraintBottom_toTopOf="@id/btn_skill_decrease"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_skill_decrease"
                style="@style/PipWizardButtonStyle"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:text="−"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingLeft="2dip"
                android:paddingRight="2dip"
                android:paddingTop="0dip"
                android:paddingBottom="0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_skill_increase" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/img_skill_selected_border"
            style="@style/ColorTintStyle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:layout_constraintStart_toStartOf="@id/layout_tab_skill_descriptions_text"
            app:layout_constraintTop_toTopOf="@id/layout_tab_skill_descriptions_text"
            app:srcCompat="@drawable/img_top_right" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_skill_descriptions_text"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.425"
            app:layout_constraintHorizontal_bias="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintWidth_percent="0.925">

            <ScrollView
                android:id="@+id/scrollview_skill_descriptions_text"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_marginTop="8.0dip"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.95"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0"
                app:layout_constraintWidth_percent="0.98">

                <TextView
                    android:id="@+id/tv_skill_descriptions_text"
                    style="@style/TextStyle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/skill_barter_description"
                    android:textAllCaps="false" />
            </ScrollView>
        
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
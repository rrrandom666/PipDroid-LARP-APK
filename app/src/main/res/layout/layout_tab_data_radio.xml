<?xml version="1.0" encoding="utf-8"?>
<!-- DATA/Radio (roadmap, этап 23, "реальное радио") — старые mp3-станции (GNR/Enclave/New
     Vegas/Custom) и аудиовизуализатор убраны целиком: реальный радиоприём идёт через
     физический модуль RDA5807M на ESP32 (протокол, разделы 3.2/3.3), телефон ничего не
     проигрывает и не тюнит сам — экран только зеркалит состояние по RADIOPWR/RADIOFREQ/VOLUME
     (см. applyRadioPowerState()/updateRadioFrequencyDisplay()/applyRadioVolumeDelta() в
     MainActivity.kt). Текст/прогресс по умолчанию ниже — нейтральная заглушка на случай, если
     код почему-то не отработает до первого апдейта от ESP32, тот же приём, что у геликсовой
     шкалы Гейгера (layout_tab_items_geiger.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_data_radio"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <!-- Не style="@style/TextStyle" (тянет layout_constraintHeight_percent, рассчитанный на
         строки списков с фиксированной высотой контейнера) и намеренно НЕ замкнутая
         вертикальная цепочка (chainStyle="packed" + bottom-констрейнт на последнем элементе) —
         на устройстве найдено, что голова и хвост такой цепочки (этот TextView и
         tv_radio_volume_value) получают вчетверо меньшую высоту, чем элементы посередине
         (42px против 76-330px при равном контенте, проверено uiautomator-дампом), и текст
         обрезается по границе View. Вместо цепочки — просто последовательное
         layout_constraintTop_toBottomOf сверху вниз, без bottom-констрейнта на последнем
         элементе: свободное место остаётся снизу, а не распределяется через packing/bias. -->
    <TextView
        android:id="@+id/tv_radio_status"
        android:fontFamily="@font/pipboy_mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:gravity="center"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textSize="28.0dip"
        android:text="@string/radio_status_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Формат "%.1f MHz" собирается кодом (updateRadioFrequencyDisplay(), Locale.US
         принудительно — иначе на RU-локали System.Locale подставляет запятую вместо точки
         как десятичный разделитель). -->
    <TextView
        android:id="@+id/tv_radio_frequency"
        android:fontFamily="@font/pipboy_mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:textAllCaps="false"
        android:text="@string/radio_frequency_placeholder"
        android:textSize="56.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_radio_status" />

    <TextView
        android:id="@+id/tv_radio_volume_label"
        android:fontFamily="@font/pipboy_mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:textAllCaps="false"
        android:textSize="24.0dip"
        android:text="@string/radio_volume_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_radio_frequency" />

    <!-- ProgressBar не подхватывает тему через android:tint (в отличие от ImageView) — тонируется
         явно кодом (applyTextColor() -> progressTintList), как и фон кнопок. max=100 совпадает с
         RADIO_VOLUME_MAX в MainActivity.kt, progress=50 — с RADIO_VOLUME_DEFAULT. -->
    <ProgressBar
        android:id="@+id/radio_volume_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:max="100"
        android:progress="50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_radio_volume_label"
        app:layout_constraintWidth_percent="0.5" />

    <TextView
        android:id="@+id/tv_radio_volume_value"
        android:fontFamily="@font/pipboy_mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:textAllCaps="false"
        android:textSize="24.0dip"
        android:text="@string/radio_volume_value_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radio_volume_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>

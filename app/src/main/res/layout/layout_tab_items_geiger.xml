<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Гейгер (roadmap, "Редизайн STATS/Status — UX-спецификация") — переехал со
     STATS/Status/RAD, но оставлена только сама шкала дозы: RAD RESIST (перк) и счётчики
     химов RadAway/RadX сняты с экрана целиком по решению этапа 22 — экран посвящён только
     накопленной радиации. Шкала (img_rad_scale/img_rad_arrow/tv_rad_arrow_value) подключена
     к реальной логике (протокол, раздел 3.4) — до этого была статичным хардкодом без
     единой строчки Kotlin-кода. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tab_items_geiger"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <!-- Шкала расширена и отцентрована (0.65 -> 0.85, привязка к обоим краям вместо
         только правого) после того, как RAD RESIST/RadAway/RadX убраны со всего экрана —
         раньше 0.65 с прижатием вправо оставляло место под них слева, теперь эта ниша
         больше ничем не занята. -->
    <ImageView
        android:id="@+id/img_rad_scale"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginBottom="64.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="889:70"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.85"
        app:srcCompat="@drawable/rad_scale2"
        tools:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/tv_rad_scale_500"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="500"
        app:layout_constraintBottom_toTopOf="@id/img_rad_scale"
        app:layout_constraintEnd_toEndOf="@id/img_rad_scale"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/img_rad_scale" />

    <TextView
        android:id="@+id/tv_rad_scale_1000"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1000"
        app:layout_constraintBottom_toTopOf="@id/img_rad_scale"
        app:layout_constraintEnd_toEndOf="@id/img_rad_scale" />

    <!-- Start/End нарочно на img_rad_scale, не на parent (как было в дохлом виджете
         до этапа 22) — иначе горизонтальный bias 0..1 отсчитывался бы от ширины всего
         экрана, а не от самой шкалы, и стрелка не совпадала бы со шкалой значений.
         horizontalBias выставляется кодом = накопленная доза / 1000 (updateGeigerDoseDisplay
         в MainActivity.kt), исходное значение ниже — нейтральная заглушка на случай,
         если код почему-то не отработает до первой отрисовки. -->
    <ImageView
        android:id="@+id/img_rad_arrow"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="30:65"
        app:layout_constraintEnd_toEndOf="@id/img_rad_scale"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/img_rad_scale"
        app:layout_constraintTop_toTopOf="@id/img_rad_scale"
        app:layout_constraintVertical_bias="0.2"
        app:srcCompat="@drawable/rad_arrow" />

    <TextView
        android:id="@+id/tv_rad_arrow_value"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8.0dip"
        android:text="@string/title_bottom_common_radiation_placeholder"
        app:layout_constraintBottom_toBottomOf="@id/img_rad_arrow"
        app:layout_constraintEnd_toEndOf="@id/img_rad_arrow" />

    <!-- Сбрасывает только локальный счётчик PipDroid (SharedPreferences), не связан с
         официальным датчиком дозы игрока — см. CLAUDE.md, "Периферия". -->
    <Button
        android:id="@+id/btn_geiger_reset"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:text="@string/geiger_reset_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

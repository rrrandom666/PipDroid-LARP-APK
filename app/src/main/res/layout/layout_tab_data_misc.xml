<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tab_data_misc"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tab_data_misc_main"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Боковое меню Files (roadmap, "Единый компонент бокового меню 3 уровня") — тот же
             SidebarMenuAdapter/RecyclerView, что у SPECIAL/Skills/Perks/Clock, вместо двух
             hand-copied ConstraintLayout-строк без энкодер-логики. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tab_data_misc"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
            android:scrollbars="vertical"
            android:verticalScrollbarPosition="left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.425" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_data_misc_descriptions"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toRightOf="@id/recycler_tab_data_misc"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <ScrollView
                android:id="@+id/scroll_tab_data_misc_text"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
                android:scrollbars="vertical"
                android:verticalScrollbarPosition="right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.925"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent">

                        <TextView
                            android:id="@+id/tv_data_misc_holotape_text"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="5dp"
                            app:layout_constraintBottom_toBottomOf="@id/scroll_tab_data_misc_text"
                            app:layout_constraintStart_toStartOf="@id/scroll_tab_data_misc_text"
                            app:layout_constraintEnd_toEndOf="@id/scroll_tab_data_misc_text"
                            app:layout_constraintTop_toTopOf="@id/scroll_tab_data_misc_text"
                            android:text="@string/data_misc_entry1_description"
                            android:clickable="false"
                            android:gravity="center|left"
                            android:minWidth="0.0dip"
                            android:minHeight="0.0dip"/>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
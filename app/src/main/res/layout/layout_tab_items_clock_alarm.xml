<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Clock/Будильник (roadmap, "Часы — UX-спецификация") — один однократный
     будильник, время задаётся свайповым колесом (ClockWheelPicker.kt, переиспользуется
     Таймером) по образцу системных часов Android. Срабатывание —
     MainActivity.checkAlarmFiring(), полноэкранный оверлей layout_clock_fired_overlay.xml
     поверх любого раздела приложения.
     Энкодер-эргономика (roadmap, этап 27, п.3) — Hour/Minute/Set/Back, прицелы-уголки
     (focus_corner_brackets). Колёса и разделитель ":" — прямые дети корневого
     ConstraintLayout (не LinearLayout, как раньше) — прицел над колесом резолвится только
     между прямыми детьми одного ConstraintLayout (см. CLAUDE.md, Journal Cancel/Save). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_clock_alarm"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <!-- Ширина — фиксированные 72dp, не процент (roadmap, этап 29, доработка после фидбека
         по тесту) — было два разных провала подряд: (1) сам по себе процент 0.065 даёт на
         обычном экране ~20-25dp, двузначное "00" в это не помещается и переносится по
         символам на вторую строку, обрезанную высотой строки 44dp (видна только ведущая
         цифра каждого числа); (2) добавленный следом app:layout_constraintWidth_min="72dp"
         как страховка от переноса неожиданно раздувал именно ПЕРВОЕ колесо цепочки
         (hour) на огромную ширину и выталкивал остальные колёса к правому краю экрана —
         сочетание constraintWidth_percent + constraintWidth_min на MATCH_CONSTRAINT-ширине
         в packed-цепочке ведёт себя не так, как расчёт "процент, зажатый минимумом"
         подсказывает по документации. Простое фиксированное значение — то же самое, что
         было ДО перевода колеса на процент в этом же коммите, и тогда работало корректно;
         высота строки внутри колеса всё равно уже отдельно адаптивна через реальные размеры
         RecyclerView (ClockWheelPicker.kt, itemHeightPx), фиксированная ширина колонки этому
         не мешает. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_clock_alarm_hour"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_clock_alarm_status"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_clock_alarm_colon"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <View
        android:id="@+id/view_clock_alarm_hour_focus"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/rv_clock_alarm_hour"
        app:layout_constraintEnd_toEndOf="@id/rv_clock_alarm_hour"
        app:layout_constraintTop_toTopOf="@id/rv_clock_alarm_hour"
        app:layout_constraintBottom_toBottomOf="@id/rv_clock_alarm_hour" />

    <TextView
        android:id="@+id/tv_clock_alarm_colon"
        style="@style/ClockStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:textSize="28sp"
        android:text=":"
        app:layout_constraintTop_toTopOf="@id/rv_clock_alarm_hour"
        app:layout_constraintBottom_toBottomOf="@id/rv_clock_alarm_hour"
        app:layout_constraintStart_toEndOf="@id/rv_clock_alarm_hour"
        app:layout_constraintEnd_toStartOf="@id/rv_clock_alarm_minute" />

    <!-- top/bottom зеркалят УЖЕ РЕЗОЛВЛЕННЫЕ края rv_clock_alarm_hour, а не независимо
         те же top=parent/bottom=status/bias — иначе два виджета с одинаковыми, но
         НЕЗАВИСИМЫМИ constraint-наборами, оба ссылающиеся на tv_clock_alarm_status (которая
         сама зависит только от hour), решаются солвером асимметрично и оказываются на
         разной высоте на пиксель-два (найдено на устройстве — колесо минут "плыло" выше
         часов). Одно направление зависимости — гарантированно то же самое место. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_clock_alarm_minute"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="@id/rv_clock_alarm_hour"
        app:layout_constraintBottom_toBottomOf="@id/rv_clock_alarm_hour"
        app:layout_constraintStart_toEndOf="@id/tv_clock_alarm_colon"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/view_clock_alarm_minute_focus"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/rv_clock_alarm_minute"
        app:layout_constraintEnd_toEndOf="@id/rv_clock_alarm_minute"
        app:layout_constraintTop_toTopOf="@id/rv_clock_alarm_minute"
        app:layout_constraintBottom_toBottomOf="@id/rv_clock_alarm_minute" />

    <!-- Три расстояния композиции (снизу вверх): кнопки-подвал самое большое, колесо-статус
         среднее, статус-кнопки самое маленькое — иначе блок визуально прилипает к подвалу
         (фидбек по итогам тестирования). -->
    <TextView
        android:id="@+id/tv_clock_alarm_status"
        style="@style/TextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/clock_alarm_status_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_clock_alarm_hour"
        app:layout_constraintBottom_toTopOf="@id/btn_clock_alarm_toggle" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_clock_alarm_toggle"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="48dp"
        android:text="@string/clock_alarm_set"
        app:layout_constraintTop_toBottomOf="@id/tv_clock_alarm_status"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginEnd="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_clock_alarm_back"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <View
        android:id="@+id/view_clock_alarm_set_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintTop_toTopOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintEnd_toEndOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintBottom_toBottomOf="@id/btn_clock_alarm_toggle" />

    <!-- Back — новый пункт (roadmap, этап 27, п.3), только поднимает курсор энкодера в
         боковое меню Clock. Виден только в режимах с физическим энкодером (не Phone),
         видимость обновляется кодом (refreshClockAlarmBackButtonVisibility()). Была
         текстовая кнопка, заменена на иконку (roadmap, этап 29) — единообразно с
         остальными Back по приложению.
         Высота — 0dp с ratio "1:1", не фиксированные 36dp (доработка после фидбека по
         тесту) — фиксированный размер не менялся вместе с соседней ТЕКСТОВОЙ кнопкой
         (btn_clock_alarm_toggle, высота которой зависит от масштаба шрифта), на сжатом
         экране переставал совпадать по высоте. Top/Bottom уже были привязаны к toggle —
         этого достаточно, чтобы 0dp-высота резолвилась В ТОЧНОСТИ равной его высоте; ratio
         досчитывает ширину от неё же, тот же приём, что у btn_journal_entry_mic (см.
         layout_journal_entry_popup.xml) — Start+End уже есть парой, ratio без них
         схлопывался бы в 0 (см. комментарий там же). -->
    <ImageButton
        android:id="@+id/btn_clock_alarm_back"
        style="@style/PipWizardButtonStyle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:tint="@null"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="@string/wizard_back"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintBottom_toBottomOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintStart_toEndOf="@id/btn_clock_alarm_toggle"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/view_clock_alarm_back_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_clock_alarm_back"
        app:layout_constraintTop_toTopOf="@id/btn_clock_alarm_back"
        app:layout_constraintEnd_toEndOf="@id/btn_clock_alarm_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_clock_alarm_back" />

</androidx.constraintlayout.widget.ConstraintLayout>

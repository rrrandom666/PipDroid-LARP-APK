<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Clock (roadmap, "Часы — UX-спецификация") — список фичей слева (Часы/
     Будильник/Таймер/Секундомер/Мелодия звонка), содержимое выбранной справа, по
     образцу layout_tab_stats_status.xml (STATUS -> CND/RAD/EFF). Раньше этот файл был
     самим содержимым (просто цифровые часы на весь экран + батарея в углу) — теперь
     контейнер, часы переехали в layout_tab_items_clock_time.xml, батарея — в шапку
     (layout_header_toplevel.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_clock"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tab_items_clock_buttons_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <include
            android:id="@+id/inc_layout_tab_items_clock_buttons"
            layout="@layout/layout_tab_items_clock_buttons"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.925" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/layout_tab_items_clock_content"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_tab_items_clock_buttons_container"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/inc_layout_tab_items_clock_time"
            layout="@layout/layout_tab_items_clock_time" />

        <include
            android:id="@+id/inc_layout_tab_items_clock_alarm"
            layout="@layout/layout_tab_items_clock_alarm"
            android:visibility="gone" />

        <include
            android:id="@+id/inc_layout_tab_items_clock_timer"
            layout="@layout/layout_tab_items_clock_timer"
            android:visibility="gone" />

        <include
            android:id="@+id/inc_layout_tab_items_clock_stopwatch"
            layout="@layout/layout_tab_items_clock_stopwatch"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Мелодия звонка (roadmap, "Часы — UX-спецификация") — не контент общей рамки, как
         остальные 4 пункта, а отдельный полноэкранный переход поверх ОБЕИХ колонок (список
         фичей слева тоже скрывается). Возврат — [Назад] последним пунктом собственного
         списка треков (layout_tab_items_clock_melody.xml), не через дерево фичей. -->
    <include
        android:id="@+id/inc_layout_tab_items_clock_melody"
        layout="@layout/layout_tab_items_clock_melody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

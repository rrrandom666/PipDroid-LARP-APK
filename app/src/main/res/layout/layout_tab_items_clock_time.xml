<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Clock/Часы (roadmap, "Часы — UX-спецификация") — первый пункт списка слева.
     Раньше был всем содержимым layout_tab_items_clock.xml (плюс батарея, теперь в шапке,
     см. layout_header_toplevel.xml) — перенесено без изменений отображения. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_clock_time"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <TextView
        android:id="@+id/tv_clock_time_s"
        style="@style/ClockStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8.0dip"
        android:layout_marginTop="32.0dip"
        android:text=":00"
        android:textSize="64.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_clock_time_hm"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Пара HH:MM + :SS — packed-цепочка (см. историю в CLAUDE.md), секунды стоят рядом
         с минутами, а не разъезжаются по ширине экрана. -->
    <TextView
        android:id="@+id/tv_clock_time_hm"
        style="@style/ClockStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="112.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_clock_time_s"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

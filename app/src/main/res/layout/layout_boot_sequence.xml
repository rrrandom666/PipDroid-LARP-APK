<?xml version="1.0" encoding="utf-8"?>
<!-- Анимация включения PipBoy 2000/3000 (roadmap, "Видение приложения", п.11) — три
     кадра, показывается поверх view_power_off при реальном POWER:1 (или debug-инъекции),
     см. MainActivity.playBootSequence(). Заменяет прежнюю заглушку — простой fade
     чёрного оверлея за 400мс.

     Кадр 1: логотип — один растровый ассет (леттеринг + молния + "2000" уже единой
     композицией, авторский рисунок, не векторная перерисовка).
     Кадр 2: стена кода, скроллится снизу вверх.
     Кадр 3: терминальная печать посимвольно с блочным курсором.

     Тематизация — ImageView.tint подхватывает тему автоматически (см. CLAUDE.md,
     "Архитектурный принцип: тематизация интерфейса"); PNG лого хранит только альфа-маску
     (RGB везде белый), заливка приходит из темы, штриховка внутри букв — часть маски. -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_boot_sequence"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Кадр 1: логотип -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_boot_frame_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_boot_logo_wordmark"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_boot_wordmark_pipboy2000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Кадр 2: стена кода, скроллится снизу вверх -->
    <FrameLayout
        android:id="@+id/layout_boot_frame_codewall"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_boot_codewall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:fontFamily="@font/pipboy_mono"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Кадр 3: терминальная печать -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_boot_frame_terminal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_boot_terminal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/pipboy_mono"
            android:lineSpacingExtra="3dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

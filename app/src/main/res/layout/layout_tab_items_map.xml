<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Map (roadmap, этап 6, п.2). Карта больше не живая osmdroid + online OSM-тайлы —
     единственный источник карты теперь бандл (map.png + map_bounds.json + map_roads.json),
     импортируемый игроком в Settings > Map (см. layout_tab_settings.xml) из готового
     пайплайна falloutize_map.py (полигон часто без интернета, см. CLAUDE.md). PhotoView
     показывает статичную привязанную по координатам картинку, MapOverlayView поверх неё —
     GPS-точка игрока, отметки, линия маршрута. Меню слева — по образцу
     layout_tab_items_clock.xml (список фичей слева / контент справа), не отдельный
     самодельный стиль. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tab_items_map"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <!-- Меню слева (Фазы D/E/F) — 0.3 ширины, тот же паттерн, что у ITEMS/Clock
         (layout_tab_items_clock.xml): CNDEFFRADButtonStyle-кнопки, список фичей. Три
         состояния переключаются видимостью (см. MapMenuState в MainActivity.kt), не три
         отдельных экрана — ровно так же Clock переключает Time/Alarm/Timer/Stopwatch. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_map_menu_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:background="@color/pip_background_darker"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <!-- Состояние 1/2: корень и подменю "Проложить маршрут" (roadmap, "Единый компонент
             бокового меню 3 уровня") — SidebarMenuAdapter вместо кнопок-LinearLayout, тот
             же приём, что у SPECIAL/Skills/Status/Clock. Список меток (состояние 3, ниже) —
             отдельная задача, шаг 7 плана, там уже есть RecyclerView+MarkerListAdapter. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_map_menu_root"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.925" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_map_menu_route_submenu"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.925" />

        <!-- Состояние 3: список отметок — общий и для корневого "Список меток", и для
             "До отметки" в подменю маршрута (см. MapMenuState.MARKER_LIST в MainActivity.kt,
             куда именно вернуться по "Назад" зависит от того, откуда вошли). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_map_menu_marker_list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:visibility="gone">

            <!-- [Назад] (roadmap, "Единый компонент бокового меню 3 уровня") — теперь
                 обычный последний пункт этого же списка (payload=null в
                 bindMarkerListAdapter()), не отдельная свёрстанная кнопка. Чинит известный
                 баг из Roadmap: кнопка была "прибита к нижнему краю и левее остальных
                 пунктов, не по общей сетке колонки", звука не было вообще — теперь и
                 выравнивание, и звук те же, что у остальных пунктов списка. -->
            <TextView
                android:id="@+id/tv_map_marker_list_empty"
                style="@style/CNDEFFRADButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_marker_list_empty"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_map_marker_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_map_marker_list_empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.925"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Контент справа — карта (по образцу layout_tab_items_clock_content) -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photo_view_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/layout_map_menu_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.malto4.pipdroid.MapOverlayView
        android:id="@+id/view_map_overlay"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"/>

    <!-- Полупрозрачная тёмная подложка под столбиком +/-/стрелка центрирования (фидбек: кнопки
         иногда сливались с пёстрым фоном карты) — идёт в разметке ПЕРЕД кнопками, чтобы
         рисоваться под ними (z-порядок ConstraintLayout — порядок объявления), константы
         привязаны к первой/последней кнопке колонки, отрицательные margin дают небольшой
         выступ подложки за края кнопок. -->
    <View
        android:id="@+id/view_map_controls_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="-6dp"
        android:layout_marginEnd="-6dp"
        android:layout_marginBottom="-6dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_zoom_in"
        app:layout_constraintEnd_toEndOf="@id/btn_map_zoom_in"
        app:layout_constraintTop_toTopOf="@id/btn_map_zoom_in"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_center" />

    <!-- Зум +/- (бэклог этапа 18) — раньше только pinch. Плавающие кнопки поверх карты в
         правом верхнем углу, тот же приём (PipWizardButtonStyle, фиксированный dp-размер), что
         у +/- на SPECIAL/Skills. -->
    <Button
        android:id="@+id/btn_map_zoom_in"
        style="@style/PipWizardButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="+"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="0dp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map" />

    <Button
        android:id="@+id/btn_map_zoom_out"
        style="@style/PipWizardButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:text="−"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="0dp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/btn_map_zoom_in"
        app:layout_constraintEnd_toEndOf="@id/btn_map_zoom_in" />

    <!-- Центрирование карты на игроке (роадмап, этап 27) — раньше пункт "Center" бокового
         меню, теперь кнопка-стрелка в том же вертикальном столбике, что и +/- (референс —
         кнопка "Моё местоположение" в Яндекс.Картах). Обработчик переиспользует
         recenterMapOnUser(), тот же, что раньше вызывал пункт меню. -->
    <ImageButton
        android:id="@+id/btn_map_center"
        style="@style/PipWizardButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_map_recenter_arrow"
        android:contentDescription="@string/map_menu_center_button"
        app:layout_constraintTop_toBottomOf="@id/btn_map_zoom_out"
        app:layout_constraintEnd_toEndOf="@id/btn_map_zoom_out" />

    <!-- Прицелы энкодера зума/центрирования (roadmap, этап 27, энкодер-эргономика карты,
         п.1) — по одному общему прицелу на весь блок +/- (тот же приём, что
         view_special_value_focus у SPECIAL/Skills — одна общая рамка на пару, не по одной
         на кнопку) и отдельный на "Центр". -->
    <View
        android:id="@+id/view_map_zoom_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_zoom_in"
        app:layout_constraintEnd_toEndOf="@id/btn_map_zoom_in"
        app:layout_constraintTop_toTopOf="@id/btn_map_zoom_in"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_zoom_out" />

    <View
        android:id="@+id/view_map_center_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_center"
        app:layout_constraintEnd_toEndOf="@id/btn_map_center"
        app:layout_constraintTop_toTopOf="@id/btn_map_center"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_center" />

    <!-- Кнопки-уголки панорамирования по краям карты (roadmap, этап 27, энкодер-эргономика
         карты, п.2) — простой текстовый глиф ">" под 4 угла поворота (android:rotation), не
         4 отдельных дровабла. Без фона (только цвет темы, ставится кодом), под каждой —
         отдельная тёмная полупрозрачная подложка для контраста с пёстрой картой (тот же
         приём/цвет, что view_map_controls_bg). Подложки идут ПЕРЕД своими кнопками в
         разметке — рисуются под ними (z-order ConstraintLayout). Все — прямые дети этого
         ConstraintLayout (не вложены), обязательное условие для constraint-привязки
         прицелов энкодера (см. CLAUDE.md). -->
    <View
        android:id="@+id/view_map_pan_up_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_up"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_up"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_up"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_up" />

    <Button
        android:id="@+id/btn_map_pan_up"
        style="@style/PipWizardButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@null"
        android:foreground="?android:attr/selectableItemBackground"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text=">"
        android:textSize="18sp"
        android:rotation="-90"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintHorizontal_bias="0.5" />

    <View
        android:id="@+id/view_map_pan_up_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_up"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_up"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_up"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_up" />

    <View
        android:id="@+id/view_map_pan_down_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_down"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_down"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_down"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_down" />

    <Button
        android:id="@+id/btn_map_pan_down"
        style="@style/PipWizardButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:background="@null"
        android:foreground="?android:attr/selectableItemBackground"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text=">"
        android:textSize="18sp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintHorizontal_bias="0.5" />

    <View
        android:id="@+id/view_map_pan_down_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_down"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_down"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_down"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_down" />

    <View
        android:id="@+id/view_map_pan_left_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_left"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_left"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_left"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_left" />

    <Button
        android:id="@+id/btn_map_pan_left"
        style="@style/PipWizardButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:foreground="?android:attr/selectableItemBackground"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text=">"
        android:textSize="18sp"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map"
        app:layout_constraintVertical_bias="0.5" />

    <View
        android:id="@+id/view_map_pan_left_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_left"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_left"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_left"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_left" />

    <View
        android:id="@+id/view_map_pan_right_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_right"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_right"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_right"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_right" />

    <Button
        android:id="@+id/btn_map_pan_right"
        style="@style/PipWizardButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="4dp"
        android:background="@null"
        android:foreground="?android:attr/selectableItemBackground"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text=">"
        android:textSize="18sp"
        android:rotation="0"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map"
        app:layout_constraintVertical_bias="0.5" />

    <View
        android:id="@+id/view_map_pan_right_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_pan_right"
        app:layout_constraintEnd_toEndOf="@id/btn_map_pan_right"
        app:layout_constraintTop_toTopOf="@id/btn_map_pan_right"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_pan_right" />

    <!-- Крестообразный прицел в центре карты (roadmap, этап 27, п.3) — фиксированная точка
         экрана (constraint-центрирование на photo_view_map), не мировая координата: карта
         двигается под ним, не он по карте. ENCBTN на нём — то же самое, что тап по центру
         экрана (см. MainActivity.mapControlChildrenNodes()). -->
    <View
        android:id="@+id/view_map_crosshair"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/ic_map_crosshair"
        android:backgroundTint="@color/map_marker_focus_red"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintTop_toTopOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map" />

    <View
        android:id="@+id/view_map_crosshair_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:backgroundTint="@color/map_marker_focus_red"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/view_map_crosshair"
        app:layout_constraintEnd_toEndOf="@id/view_map_crosshair"
        app:layout_constraintTop_toTopOf="@id/view_map_crosshair"
        app:layout_constraintBottom_toBottomOf="@id/view_map_crosshair" />

    <!-- Кнопка выхода из режима "Управление картой"/"До точки на карте" (roadmap, этап 27,
         п.4) — правый нижний угол карты, полупрозрачная подложка для контраста, как у
         столбика +/-. В отличие от уголков панорамирования выше — обычный
         PipWizardButtonStyle (фон/рамка допустимы). -->
    <View
        android:id="@+id/view_map_control_back_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="-6dp"
        android:layout_marginEnd="-6dp"
        android:layout_marginBottom="-6dp"
        android:background="@color/map_controls_panel_bg"
        app:layout_constraintStart_toStartOf="@id/btn_map_control_back"
        app:layout_constraintEnd_toEndOf="@id/btn_map_control_back"
        app:layout_constraintTop_toTopOf="@id/btn_map_control_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_control_back" />

    <Button
        android:id="@+id/btn_map_control_back"
        style="@style/PipWizardButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:text="←"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="0dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map" />

    <View
        android:id="@+id/view_map_control_back_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_map_control_back"
        app:layout_constraintEnd_toEndOf="@id/btn_map_control_back"
        app:layout_constraintTop_toTopOf="@id/btn_map_control_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_map_control_back" />

    <!-- Прицел энкодера (roadmap, этап 27) над отметкой, выбранной в "Список меток" —
         переиспользует focus_corner_brackets, как и остальной энкодер-фокус в приложении
         (см. CLAUDE.md), но позиционируется НЕ constraint-привязкой к @id (отметки рисуются
         вручную на Canvas в MapOverlayView, своего View/id у них нет) — код выставляет
         translationX/Y вручную (см. updateMapMarkerFocus() в MainActivity.kt). Фиксированный
         красный, не акцент темы — дефолтный белый на пёстрой карте не виден. -->
    <View
        android:id="@+id/view_map_marker_focus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:backgroundTint="@color/map_marker_focus_red"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintTop_toTopOf="@id/photo_view_map" />

    <!-- Тап по произвольной пустой точке карты (бэклог этапа 18) — вместо жёстко
         предопределённого действия предлагает выбор: построить маршрут до точки или
         поставить здесь отметку. Тот же приём позиционирования, что и у карточки деталей
         отметки ниже (плавающая панель внизу карты) — выбор пользователя, см. обсуждение. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_map_tap_choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/pip_background_darker"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map">

        <TextView
            android:id="@+id/tv_map_tap_choice_coords"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_map_tap_choice_route"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_marker_detail_route_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_tap_choice_coords"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_map_tap_choice_marker"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/map_menu_place_marker_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_tap_choice_coords"
            app:layout_constraintStart_toEndOf="@id/btn_map_tap_choice_route" />

        <!-- Cancel (фидбек: панель координат при тапе по пустой точке нечем было закрыть,
             кроме выбора Route/Marker) — просто прячет панель, hideMapTapChoice(). -->
        <Button
            android:id="@+id/btn_map_tap_choice_cancel"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/cancel"
            app:layout_constraintTop_toBottomOf="@id/tv_map_tap_choice_coords"
            app:layout_constraintStart_toEndOf="@id/btn_map_tap_choice_marker" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Управление построенным маршрутом (бэклог этапа 18) — Start/Cancel сразу после
         построения, после Start — один Stop вместо них (оба сбрасывают маршрут). Строка
         статуса (tv_map_route_status) пустует, пока маршрут не запущен, во время следования
         (Фаза "режим следования") в неё пишется остаток дистанции — тот же слот, что и у
         подсказок/деталей отметки, см. updateRouteControlsVisibility() в MainActivity.kt. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_map_route_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/pip_background_darker"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map">

        <TextView
            android:id="@+id/tv_map_route_status"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_map_route_start"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_route_start_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_route_status"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_map_route_cancel"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/map_route_cancel_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_route_status"
            app:layout_constraintStart_toEndOf="@id/btn_map_route_start" />

        <Button
            android:id="@+id/btn_map_route_stop"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_route_stop_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_route_status"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Карточка деталей выбранной отметки (из "Список меток"/"До отметки") — имя,
         координаты, действия. Своя, не полноэкранная — только над картой, справа от меню. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_map_marker_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/pip_background_darker"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="@id/photo_view_map">

        <TextView
            android:id="@+id/tv_map_marker_detail_name"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_map_marker_detail_coords"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_map_marker_detail_name"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_map_marker_detail_edit"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_marker_detail_edit_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_marker_detail_coords"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Прицелы энкодера (roadmap, этап 27, п.9) — прямые сиблинги своих кнопок в этом
             же ConstraintLayout (обязательное условие constraint-привязки, см. CLAUDE.md —
             найденный баг с Cancel/Save у Journal). -->
        <View
            android:id="@+id/view_map_marker_detail_edit_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_map_marker_detail_edit"
            app:layout_constraintEnd_toEndOf="@id/btn_map_marker_detail_edit"
            app:layout_constraintTop_toTopOf="@id/btn_map_marker_detail_edit"
            app:layout_constraintBottom_toBottomOf="@id/btn_map_marker_detail_edit" />

        <Button
            android:id="@+id/btn_map_marker_detail_route"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/map_marker_detail_route_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_marker_detail_coords"
            app:layout_constraintStart_toEndOf="@id/btn_map_marker_detail_edit" />

        <View
            android:id="@+id/view_map_marker_detail_route_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_map_marker_detail_route"
            app:layout_constraintEnd_toEndOf="@id/btn_map_marker_detail_route"
            app:layout_constraintTop_toTopOf="@id/btn_map_marker_detail_route"
            app:layout_constraintBottom_toBottomOf="@id/btn_map_marker_detail_route" />

        <Button
            android:id="@+id/btn_map_marker_detail_delete"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/map_marker_detail_delete_button"
            app:layout_constraintTop_toBottomOf="@id/tv_map_marker_detail_coords"
            app:layout_constraintStart_toEndOf="@id/btn_map_marker_detail_route" />

        <View
            android:id="@+id/view_map_marker_detail_delete_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_map_marker_detail_delete"
            app:layout_constraintEnd_toEndOf="@id/btn_map_marker_detail_delete"
            app:layout_constraintTop_toTopOf="@id/btn_map_marker_detail_delete"
            app:layout_constraintBottom_toBottomOf="@id/btn_map_marker_detail_delete" />

        <!-- Только режимы с физическим энкодером (roadmap, этап 27, п.9) — видимость
             переключается refreshMapMarkerDetailBackButtonVisibility(), тот же гейт, что
             btn_journal_entry_detail_back. -->
        <Button
            android:id="@+id/btn_map_marker_detail_back"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/wizard_back"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_map_marker_detail_coords"
            app:layout_constraintStart_toEndOf="@id/btn_map_marker_detail_delete" />

        <View
            android:id="@+id/view_map_marker_detail_back_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_map_marker_detail_back"
            app:layout_constraintEnd_toEndOf="@id/btn_map_marker_detail_back"
            app:layout_constraintTop_toTopOf="@id/btn_map_marker_detail_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_map_marker_detail_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Полоса подсказок внизу карты (не текст на кнопке!) — режимы "тапни по карте, чтобы
         поставить отметку/построить маршрут", ошибки маршрута и т.п. Без style=
         CNDEFFRADButtonStyle нарочно — тот со своим android:background конфликтовал с фоном,
         который выставляется кодом (showMapHint()), фон оставался не тем, что задавался. -->
    <TextView
        android:id="@+id/tv_map_hint"
        android:fontFamily="@font/pipboy_mono"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_PermissionsCheckResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/items_map_no_bundle_imported"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <include
        android:id="@+id/inc_layout_tab_items_map_name_popup"
        layout="@layout/inc_layout_tab_items_map_name_popup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/photo_view_map"
        app:layout_constraintEnd_toEndOf="@id/photo_view_map"
        app:layout_constraintWidth_percent="0.6" />
</androidx.constraintlayout.widget.ConstraintLayout>

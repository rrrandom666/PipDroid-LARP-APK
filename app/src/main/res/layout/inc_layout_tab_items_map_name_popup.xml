<?xml version="1.0" encoding="utf-8"?>
<!-- Ввод имени маркера сразу после тапа в режиме расстановки (Фаза E). В проекте нет
     AlertDialog вообще — небольшая GONE/VISIBLE подпанель поверх экрана карты, тот же
     приём, что у CND-попапа (layout_tab_stats_cnd_popup.xml), themed. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_map_name_popup"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@color/pip_background_darker"
    android:elevation="24dp"
    android:clipToPadding="false"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintWidth_percent="0.6">

    <EditText
        android:id="@+id/et_marker_name_value"
        style="@style/SettingsButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/marker_name_popup_heading"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Голосовой ввод (Vosk) — тот же приём, что у Journal (layout_journal_entry_popup.xml,
         btn_journal_entry_mic): тап 1 старт/тап 2 стоп, alpha 0.4 пока модель не
         импортирована, звук недоступного действия вместо android:enabled="false" (той же
         причине — тап обязан доехать до playErrorAudio()). В отличие от Journal — здесь
         распознанный текст ЗАМЕНЯЕТ поле целиком, не дописывается в конец (roadmap, этап 28,
         п.6): имя метки — короткая фраза, а не нарастающий текст записи. -->
    <ImageButton
        android:id="@+id/btn_marker_name_popup_mic"
        style="@style/PipWizardButtonStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic"
        android:tint="@null"
        android:contentDescription="@null"
        android:alpha="0.4"
        app:layout_constraintTop_toBottomOf="@id/et_marker_name_value"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/view_marker_name_popup_mic_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_marker_name_popup_mic"
        app:layout_constraintEnd_toEndOf="@id/btn_marker_name_popup_mic"
        app:layout_constraintTop_toTopOf="@id/btn_marker_name_popup_mic"
        app:layout_constraintBottom_toBottomOf="@id/btn_marker_name_popup_mic" />

    <Button
        android:id="@+id/btn_marker_name_popup_cancel"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="12dp"
        android:text="@string/filter_cancel_button"
        app:layout_constraintTop_toBottomOf="@id/et_marker_name_value"
        app:layout_constraintBottom_toBottomOf="@id/btn_marker_name_popup_save"
        app:layout_constraintEnd_toStartOf="@id/btn_marker_name_popup_save" />

    <!-- Прицелы энкодера (roadmap, доработка после фидбека, п.5) — прямые сиблинги своих
         кнопок в этом же ConstraintLayout (см. CLAUDE.md). Отрицательный отступ уходит в
         padding контейнера (12dp, с запасом) — нужен явный android:clipToPadding="false" на
         самом контейнере (см. выше), иначе ViewGroup по умолчанию обрезает рисование детей
         по границе именно padded-области, не только по внешней границе (тот же баг и приём,
         что уже был на Stop/фигуре в Status, см. layout_tab_stats_status_cnd_content.xml). -->
    <View
        android:id="@+id/view_marker_name_popup_cancel_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_marker_name_popup_cancel"
        app:layout_constraintEnd_toEndOf="@id/btn_marker_name_popup_cancel"
        app:layout_constraintTop_toTopOf="@id/btn_marker_name_popup_cancel"
        app:layout_constraintBottom_toBottomOf="@id/btn_marker_name_popup_cancel" />

    <Button
        android:id="@+id/btn_marker_name_popup_save"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filter_save_button"
        app:layout_constraintTop_toBottomOf="@id/et_marker_name_value"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/view_marker_name_popup_save_focus"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/focus_corner_brackets"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/btn_marker_name_popup_save"
        app:layout_constraintEnd_toEndOf="@id/btn_marker_name_popup_save"
        app:layout_constraintTop_toTopOf="@id/btn_marker_name_popup_save"
        app:layout_constraintBottom_toBottomOf="@id/btn_marker_name_popup_save" />

    <!-- Нижняя граница более высокой из Mic/Cancel/Save (тот же приём, что у Journal,
         barrier_journal_entry_row в layout_journal_entry_popup.xml) — статус-строка диктовки
         упирается именно в неё. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_marker_name_popup_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btn_marker_name_popup_mic,btn_marker_name_popup_cancel,btn_marker_name_popup_save" />

    <!-- Статус диктовки (нет модели / загрузка / слушаю / ошибка) — тот же приём, что у
         tv_journal_entry_mic_status. -->
    <TextView
        android:id="@+id/tv_marker_name_popup_mic_status"
        style="@style/CNDEFFRADButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        app:layout_constraintTop_toBottomOf="@id/barrier_marker_name_popup_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

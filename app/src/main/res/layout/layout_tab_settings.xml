<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tab_settings"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/pip_background_darker">

    <!-- 96%-вставка + тонкие линии сверху/снизу вместо старой боксовой рамки
         (settings_menu_background_green) — тот же приём, что у мастера/дисклеймера/
         мод-селекта/фильтра (roadmap, "Редизайн экрана фильтра — UX-спецификация"). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_settings_frame"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <ImageView
            android:id="@+id/img_settings_line_top"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <ImageView
            android:id="@+id/img_settings_line_bottom"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

    <TextView
        android:id="@+id/tv_settings"
        style="@style/CNDEFFRADButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        app:layout_constraintTop_toBottomOf="@id/img_settings_line_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.0" />

    <Button
        android:id="@+id/btn_settings_close"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:text=" X "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_settings_line_top"
        app:layout_constraintHorizontal_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_settings_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/img_settings_line_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_settings_close">

        <ScrollView
            android:id="@+id/scroll_tab_settings"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
            android:scrollbars="vertical"
            android:verticalScrollbarPosition="left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_tab_settings_aditional"
            app:layout_constraintHeight_percent="0.925"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6">

            <LinearLayout
                android:id="@+id/linearlayout_tab_settings_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_1"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_1_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_1"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_1_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_1_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_1_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="PLAYER NAME"
                        android:maxLines="1"
                        android:maxLength="16"
                        android:singleLine="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_1"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_1_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Игровой регион (roadmap, "Новая шапка + единый Settings") — выводится
                     в общей нижней панели рядом с именем игрока, см.
                     layout_header_bottom_common.xml. Дефолт "Richmond" — как у Player Name,
                     задаётся хинтом здесь, а не строковым ресурсом (тот же приём). -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_region"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_region_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_region"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_region_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_region_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_region_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="Richmond"
                        android:maxLines="1"
                        android:maxLength="16"
                        android:singleLine="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_region"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_region_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_2"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_2_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_2"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_2_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_2_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_2_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="1"
                        android:maxLines="1"
                        android:maxLength="3"
                        android:singleLine="true"
                        android:inputType="number"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_2_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_3"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_3_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_3"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_3_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_3_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_3_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="Music"
                        app:layout_constraintWidth_percent="0.4"
                        android:maxLines="1"
                        android:singleLine="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_3"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_3_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_4"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_4_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_4"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_4_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_4_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/btn_settings_change_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/settings_menu_background_green"
                        android:text="@string/settings_mode_change_button"
                        style="@style/CNDEFFRADButtonStyle"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_4"
                        app:layout_constraintTop_toTopOf="parent"  />

                    <TextView
                        android:id="@+id/tv_settings_4_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_5"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_5_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_5"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_5_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_5_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_5_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="1"
                        android:maxLines="1"
                        android:maxLength="10"
                        android:singleLine="true"
                        android:inputType="numberDecimal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_5"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_5_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Игровой год (roadmap, "Новая шапка + единый Settings", п.2): подменяет
                     только поле YEAR у Calendar перед форматированием даты в нижних панелях
                     ITEMS/DATA/RADIO, реальные месяц/день/время не трогает. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_year"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp">

                    <TextView
                        android:id="@+id/tv_settings_year_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_year"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:background="@drawable/button_unselected"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/settings_year_name"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_year_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_settings_year_value"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center|right"
                        android:hint="2276"
                        android:maxLines="1"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:inputType="number"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_year"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_settings_year_right_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.06" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_DateFormat"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp"
                    android:paddingTop="10dip">

                    <TextView
                        android:id="@+id/tv_settings_DateFormat_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_settings_DateFormat_title"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_DateFormat_title"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:paddingBottom="10dip"
                        android:text="@string/settings_6_name"
                        android:textAllCaps="false"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_DateFormat_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioGroup
                        android:id="@+id/rg_settings_dateformat"
                        style="@style/SettingsButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkedButton="@id/rb_settings_dateformat_1"
                        android:paddingBottom="10dp"
                        android:textAllCaps="false"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_DateFormat_left_spacer"
                        app:layout_constraintTop_toBottomOf="@id/tv_settings_DateFormat_title">

                        <RadioButton
                            android:id="@+id/rb_settings_dateformat_1"
                            style="@style/SettingsButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_6_value_1" />
                        <RadioButton
                            android:id="@+id/rb_settings_dateformat_2"
                            style="@style/SettingsButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_6_value_2" />
                        <RadioButton
                            android:id="@+id/rb_settings_dateformat_3"
                            style="@style/SettingsButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_6_value_3" />
                        <RadioButton
                            android:id="@+id/rb_settings_dateformat_4"
                            style="@style/SettingsButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_6_value_4" />
                        <RadioButton
                            android:id="@+id/rb_settings_dateformat_5"
                            style="@style/SettingsButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_6_value_5" />
                    </RadioGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_tab_settings_language"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.0dp"
                    android:paddingTop="10dip">

                    <TextView
                        android:id="@+id/tv_settings_language_left_spacer"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_settings_language_title"
                        app:layout_constraintWidth_percent="0.03" />

                    <TextView
                        android:id="@+id/tv_settings_language_title"
                        style="@style/CNDEFFRADButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:clickable="false"
                        android:gravity="center|left"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:paddingBottom="10dip"
                        android:text="@string/settings_language_name"
                        android:textAllCaps="false"
                        app:layout_constraintStart_toEndOf="@id/tv_settings_language_left_spacer"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Независим от системного языка телефона (roadmap, локализация,
                         шаг 4) — MainActivity.attachBaseContext() читает appLanguage_SPKey
                         и подменяет Locale контекста, пока значение не выбрано явно,
                         работает обычный values-ru фолбэк по системной локали. Названия
                         языков ("Русский"/"English") намеренно не переведены — так само
                         название языка принято показывать в любом интерфейсе. -->

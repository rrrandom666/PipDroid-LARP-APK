<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Journal (roadmap, этап 20) — личные записи игрока, текстовый ввод; голосовой
     (Vosk) — следующий отдельный шаг, кнопка-заглушка уже зарезервирована в попапе ввода
     (layout_journal_entry_popup.xml). Список слева/контент справа — тот же паттерн, что у
     ITEMS/Map/Clock (см. CLAUDE.md). Единый список слева (SidebarMenuAdapter) — первый пункт
     всегда "Новая запись" (payload=null в bindJournalListAdapter()), не отдельная кнопка. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_journal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_journal_menu_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:background="@color/pip_background_darker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_journal_entry_list"
            style="@style/SidebarListScrollbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Контент справа — взаимоисключающе: подсказка (либо "нет записей", либо "выбери
         запись" — какая из двух зависит от того, есть ли вообще записи, см.
         hideJournalEntryDetail() в MainActivity.kt) или карточка детали записи. Тот же
         паттерн, что tv_map_hint/layout_map_marker_detail. -->
    <TextView
        android:id="@+id/tv_journal_hint"
        android:fontFamily="@font/pipboy_mono"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:gravity="center"
        android:text="@string/journal_hint"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- clipToPadding=false — обязателен под прицелы-уголки с отрицательным margin поверх
         Edit/Delete/Back (roadmap, этап 27 — тот же приём и та же ловушка, что у
         layout_geiger_bottom_buttons в layout_tab_items_geiger.xml, см. CLAUDE.md). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_journal_entry_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_journal_entry_detail_date"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ScrollView
            android:id="@+id/scroll_journal_entry_detail_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_journal_entry_detail_date"
            app:layout_constraintBottom_toTopOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_journal_entry_detail_text"
                style="@style/CNDEFFRADButtonStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

        <!-- Эталон высоты для Edit/Delete/Back ниже (доработка после фидбека по тесту) —
             невидимая ТЕКСТОВАЯ кнопка того же стиля (PipWizardButtonStyle), в этом ряду
             нет ни одной настоящей, к которой можно было бы привязать Top/Bottom иконок
             напрямую (в отличие от Alarm/Timer/Stopwatch/Ringtones/Map — там рядом всегда
             есть Start/Reset/Cancel/Select, см. их XML). android:visibility="invisible", не
             "gone" — GONE-view в ConstraintLayout не участвует в расчёте констрейнтов
             соседей вообще (схлопывается в 0), INVISIBLE сохраняет реальные измеренные
             размеры, просто не рисуется — то, что нужно для точного эталона. Пустой текст —
             высота Button не зависит от длины текста, только от паддинга стиля (4dp+4dp) и
             высоты строки шрифта, которые те же, что и у любой другой кнопки этого стиля. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_journal_entry_detail_height_ref"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:text=""
            android:visibility="invisible"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Edit/Delete/Back — были текстовыми кнопками, заменены на иконки (roadmap,
             этап 29), тот же набор, что в карточке отметки на карте
             (layout_tab_items_map.xml) — единообразие по всему приложению.
             Высота — 0dp с ratio "1:1" от эталона выше, не фиксированные 36dp (доработка
             после фидбека по тесту) — фиксированный размер не совпадал по высоте с
             текстовыми кнопками того же стиля на сжатом экране (см. подробный комментарий
             у btn_clock_alarm_back, layout_tab_items_clock_alarm.xml). Раньше у Edit не
             было End вообще (фиксированный размер в нём не нуждался) — ratio требует парный
             Start+End на считаемой оси (см. тот же комментарий), но три кнопки с End
             друг на друга случайно замкнулись в полноценную цепочку parent-to-parent,
             которая без chainStyle по умолчанию "spread" — раздвинула бы иконки лишними
             промежутками вместо плотной группы слева. chainStyle="packed" на первом
             элементе цепочки (Edit) возвращает прежнее плотное выравнивание. -->
        <ImageButton
            android:id="@+id/btn_journal_entry_detail_edit"
            style="@style/PipWizardButtonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:tint="@null"
            android:src="@drawable/ic_edit_pencil"
            android:contentDescription="@string/map_marker_detail_edit_button"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_journal_entry_detail_delete"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.0" />

        <!-- Прицелы-уголки курсора энкодера (roadmap, этап 27 — энкодер-эргономика ITEMS:
             Journal) — та же схема, что у view_geiger_reset_focus/view_geiger_menu_focus. -->
        <View
            android:id="@+id/view_journal_entry_detail_edit_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintEnd_toEndOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_edit" />

        <ImageButton
            android:id="@+id/btn_journal_entry_detail_delete"
            style="@style/PipWizardButtonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:tint="@null"
            android:src="@drawable/ic_delete_trash"
            android:contentDescription="@string/map_marker_detail_delete_button"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintStart_toEndOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintEnd_toStartOf="@id/btn_journal_entry_detail_back"
            app:layout_goneMarginEnd="0dp" />

        <View
            android:id="@+id/view_journal_entry_detail_delete_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_journal_entry_detail_delete"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_delete"
            app:layout_constraintEnd_toEndOf="@id/btn_journal_entry_detail_delete"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_delete" />

        <!-- Back — новый пункт (roadmap, этап 27, п.4): только возвращает курсор энкодера в
             боковое меню, самой записи не касается. Нужна только в режимах с физическим
             энкодером — gone по умолчанию, как у btn_geiger_menu, реальная видимость
             выставляется кодом (refreshJournalBackButtonVisibility()). -->
        <ImageButton
            android:id="@+id/btn_journal_entry_detail_back"
            style="@style/PipWizardButtonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:tint="@null"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="@string/wizard_back"
            android:visibility="gone"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_height_ref"
            app:layout_constraintStart_toEndOf="@id/btn_journal_entry_detail_delete"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/view_journal_entry_detail_back_focus"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/focus_corner_brackets"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/btn_journal_entry_detail_back"
            app:layout_constraintTop_toTopOf="@id/btn_journal_entry_detail_back"
            app:layout_constraintEnd_toEndOf="@id/btn_journal_entry_detail_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_journal_entry_detail_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Редактор записи (roadmap, этап 27, п.1) — раньше всплывающая панель поверх контента
         (60% ширины, wrap_content сверху), теперь полноценное состояние контентной области,
         взаимоисключающее с подсказкой/карточкой детали выше: при создании занимает то же
         место, что подсказка, при редактировании — заменяет собой карточку записи. -->
    <include
        android:id="@+id/inc_layout_tab_items_journal_entry_popup"
        layout="@layout/layout_journal_entry_popup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Нижняя контекстная панель для STATS (roadmap, "Новая шапка + единый Settings", п.3) —
     LVL/HP/AP/XP, переехали из старой шапки (layout_tab_stats_title.xml, теперь удалена).
     Значение раздела (было "STATS" в старой шапке) больше не дублируется — оно уже видно
     как активная кнопка в row1. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_header_bottom_stats"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <TextView
        android:id="@+id/tv_title_lvl"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center|left"
        android:text="LVL"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_stats_lvl_value"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center|left"
        android:text="@string/title_stats_status_lvl"
        app:layout_constraintLeft_toRightOf="@id/tv_title_lvl"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_top_link_2"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/img_top_link_3"
        app:layout_constraintStart_toEndOf="@id/tv_title_stats_lvl_value"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_top_link_2" />

    <TextView
        android:id="@+id/tv_title_hp"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="5dp"
        android:gravity="center|left"
        android:text="HP"
        app:layout_constraintLeft_toLeftOf="@id/img_top_link_2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_hp_value"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center|left"
        android:text="@string/title_stats_status_hp"
        app:layout_constraintRight_toRightOf="@id/img_top_link_2"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_top_link_3"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/img_top_right"
        app:layout_constraintStart_toEndOf="@id/img_top_link_2"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_top_link_3" />

    <TextView
        android:id="@+id/tv_title_stats_ap"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="5dp"
        android:gravity="center|left"
        android:text="AP"
        app:layout_constraintLeft_toLeftOf="@id/img_top_link_3"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_stats_ap_value"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center|left"
        android:text="@string/title_stats_status_ap"
        app:layout_constraintRight_toRightOf="@id/img_top_link_3"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_top_right"
        style="@style/ColorTintStyle"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_top_link_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        app:srcCompat="@drawable/img_top_right" />

    <TextView
        android:id="@+id/tv_title_stats_xp"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="5dp"
        android:gravity="center|left"
        android:text="XP"
        app:layout_constraintLeft_toLeftOf="@id/img_top_right"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_stats_xp_value"
        style="@style/TopTitleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center|left"
        android:text="@string/title_stats_status_xp"
        app:layout_constraintRight_toRightOf="@id/img_top_right"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

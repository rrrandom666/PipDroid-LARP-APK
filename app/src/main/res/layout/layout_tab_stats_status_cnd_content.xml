                android:layout_height="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="99:52"
                app:layout_constraintHeight_percent="0.177"
                app:layout_constraintHorizontal_bias="0.080"

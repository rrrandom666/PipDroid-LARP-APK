<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_pipboy2000_wizard"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@android:color/black">

    <!-- 96%-вставка + тонкие линии сверху/снизу — общая рамка для экранов 2-5 мастера
         (roadmap "Косметические правки мастера"), тот же приём, что у дисклеймера
         (layout_tab_tutorial_base.xml) и мод-селекта (layout_tab_mode_select.xml). Шаг 6
         (подсказка POWER) сознательно вне рамки — это чёрный экран состояния OFF, не
         страница мастера. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_chrome_frame"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <ImageView
            android:id="@+id/img_wizard_line_top"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <ImageView
            android:id="@+id/img_wizard_line_bottom"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

    <!-- Шаг 2: HARDWARE INSTRUCTIONS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_hardware"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/img_wizard_line_top"
        app:layout_constraintBottom_toTopOf="@id/img_wizard_line_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_wizard_hardware_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:text="@string/wizard_hardware_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/img_wizard_vaultboy"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/pipboy_3nv"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_hardware_title"
            app:layout_constraintBottom_toTopOf="@id/tv_wizard_hardware_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_wizard_hardware_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:text="@string/wizard_hardware_text"
            app:layout_constraintBottom_toTopOf="@id/btn_wizard_hardware_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_wizard_hardware_back"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="@string/wizard_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_wizard_hardware_next" />

        <Button
            android:id="@+id/btn_wizard_hardware_next"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="@string/wizard_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_wizard_hardware_back"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Шаг 3: DISPLAY AREA. Заголовок и уголки — намеренно ближе к самому краю (было
         актуально при вертикальном стеке кнопок, roadmap-история; после перехода на
         горизонтальный ряд освободившееся место ушло в отступ заголовок/текст ниже). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_display_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/img_wizard_line_top"
        app:layout_constraintBottom_toTopOf="@id/img_wizard_line_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_wizard_display_area_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/wizard_display_area_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Уголки-индикаторы регулируемой области: одна векторная стрелка, повёрнутая
             под каждый угол (roadmap: "стрелки должны быть жирнее, как на референсе"). -->
        <ImageView android:id="@+id/img_wizard_corner_tl" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:src="@drawable/ic_wizard_corner_arrow" android:rotation="-45"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
        <ImageView android:id="@+id/img_wizard_corner_tr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:src="@drawable/ic_wizard_corner_arrow" android:rotation="45"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/img_wizard_corner_bl" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:src="@drawable/ic_wizard_corner_arrow" android:rotation="225"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />
        <ImageView android:id="@+id/img_wizard_corner_br" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:src="@drawable/ic_wizard_corner_arrow" android:rotation="135"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_wizard_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:text="@string/wizard_hint_resize"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_display_area_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Один горизонтальный ряд вместо вертикального стека (roadmap, "Косметические
             правки мастера" — освободило место под увеличенный отступ заголовок/текст выше).
             Одна ширина у всех трёх — код, equalizeButtonWidths() (MainActivity.kt), тот же
             приём, что и у кнопок дисклеймера. -->
        <LinearLayout
            android:id="@+id/layout_wizard_display_area_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_hint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_wizard_done"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/wizard_done" />

            <Button
                android:id="@+id/btn_wizard_reset"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/wizard_reset" />

            <Button
                android:id="@+id/btn_wizard_cancel"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wizard_cancel" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Шаг 4: PERMISSIONS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_permissions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/img_wizard_line_top"
        app:layout_constraintBottom_toTopOf="@id/img_wizard_line_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_wizard_permissions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:text="@string/wizard_permissions_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_wizard_permissions_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:text="@string/wizard_permissions_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btn_wizard_grant_permissions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- [Назад]/[Выдать разрешения] по противоположным краям экрана, без выравнивания
             по ширине (тексты сильно разной длины) — тот же приём, что на экране 2
             (roadmap, "Косметические правки мастера"). -->
        <Button
            android:id="@+id/btn_wizard_permissions_back"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="@string/wizard_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_wizard_grant_permissions" />

        <Button
            android:id="@+id/btn_wizard_grant_permissions"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="@string/wizard_grant_permissions"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_wizard_permissions_back"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Шаг 5: PAIRING — скан по Service UUID Nordic UART, список найденных корпусов вместо
         ручного ввода MAC (roadmap). Кнопки списка создаются в коде (setWizardButtonState-
         подобный тинт акцентом темы), см. startPairingScan()/addPairingDevice(). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_pairing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/img_wizard_line_top"
        app:layout_constraintBottom_toTopOf="@id/img_wizard_line_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_wizard_pairing_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:text="@string/wizard_pairing_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_wizard_pairing_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:text="@string/wizard_pairing_scanning"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_pairing_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:id="@+id/scroll_wizard_pairing_devices"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_pairing_status"
            app:layout_constraintBottom_toTopOf="@id/layout_wizard_pairing_scan_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layout_wizard_pairing_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- [Назад] у левого края, [Skip (debug)]+[Скан. снова] — своя пара вплотную у
             правого края (roadmap, "Косметические правки мастера"), тот же приём
             противоположных краёв, что на экране 2. -->
        <Button
            android:id="@+id/btn_wizard_pairing_back"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/wizard_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layout_wizard_pairing_scan_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Обход реального сопряжения в debug-сборках (roadmap, этап 7, "быстрая
                 отладка логики экранов") — видимость переключается кодом в
                 setupPipBoy2000Wizard(), в release всегда gone. -->
            <Button
                android:id="@+id/btn_wizard_pairing_skip_debug"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="SKIP (DEBUG)"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_wizard_pairing_rescan"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wizard_pairing_rescan" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Шаг 6: подсказка про POWER — вне рамки (état OFF, чёрный экран, не страница мастера,
         roadmap "Косметические правки мастера"). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_wizard_power_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_wizard_power_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:text="@string/wizard_hint_connect_hardware"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_wizard_hide_hint"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/wizard_hide_hint"
            app:layout_constraintTop_toBottomOf="@id/tv_wizard_power_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

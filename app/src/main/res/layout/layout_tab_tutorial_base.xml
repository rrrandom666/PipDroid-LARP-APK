<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <!-- Корень (activity_main.xml, constraintlayoutTutorial) — полноэкранный непрозрачный
         фон, чтобы мод-селект под дисклеймером не просвечивал по краям. Сам контент — в
         96%-вставке, как и у constraintlayoutMain основного экрана (roadmap, "Дисклеймер
         при запуске — UX-спецификация") — так линии сверху/снизу заканчиваются на том же
         отступе от края экрана, что и у шапки/футера основного экрана. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tutorial_content_area"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <!-- Тонкие линии сверху/снизу вместо старой рамки — тот же переиспользуемый приём,
             что у шапки основного экрана (img_header_line, layout_header_toplevel.xml):
             ColorTintStyle красит их акцентом текущей темы через унаследованный
             android:tint. -->
        <ImageView
            android:id="@+id/img_tutorial_line_top"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <ImageView
            android:id="@+id/img_tutorial_line_bottom"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <!-- Левая колонка — текст (двухколоночный макет, как у остальных экранов мастера). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintlayoutTutorialContent"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintTop_toBottomOf="@id/img_tutorial_line_top"
            app:layout_constraintBottom_toTopOf="@id/img_tutorial_line_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_tutorial_buttons">

            <include
                android:id="@+id/inc_layout_tab_tutorial_welcome"
                layout="@layout/layout_tab_tutorial_welcome"
                android:visibility="visible" />

            <!-- 7 страниц тьюториала (roadmap, этап 25) — один переиспользуемый layout,
                 текст подставляется кодом по индексу (MainActivity.showTutorialPage()). -->
            <include
                android:id="@+id/inc_layout_tab_tutorial_page"
                layout="@layout/layout_tab_tutorial_page"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Правая колонка — Далее / Пропустить / чекбокс, сверху вниз (roadmap-спека). -->
        <LinearLayout
            android:id="@+id/layout_tutorial_buttons"
            android:layout_width="wrap_content"
            android:layout_height="0.0dip"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/img_tutorial_line_top"
            app:layout_constraintBottom_toTopOf="@id/img_tutorial_line_bottom"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_nextpage"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/wizard_next" />

            <Button
                android:id="@+id/btn_tutorial_close"
                style="@style/PipWizardButtonStyle"
                android:layout_width="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/disclaimer_skip_button" />

            <CheckBox
                android:id="@+id/cbox_tutorial_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pipboy_mono"
                android:text="@string/disclaimer_dont_show_again"
                android:checked="false" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Блик экрана (activity_main.xml, img_screenglare) поверх дисклеймера — своя копия
         по той же причине, что и у заставки/мастера: дисклеймер рисуется отдельным
         инклюдом поверх оригинального блика и перекрывает его собой. -->
    <ImageView
        android:id="@+id/img_screenglare_welcome"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/screenglare_alpha"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

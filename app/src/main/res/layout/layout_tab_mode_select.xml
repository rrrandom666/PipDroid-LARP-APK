<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_mode_select"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/pip_background_darker">

    <LinearLayout
        android:id="@+id/layout_mode_select_buttons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_mode_select_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/mode_phone"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_select_pipboy2000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/mode_pipboy_2000"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_select_pipboy3000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_pipboy_3000"
            android:textAllCaps="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_mode_select_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_mode_select_buttons"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

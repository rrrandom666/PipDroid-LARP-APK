<?xml version="1.0" encoding="utf-8"?>
<!-- Раздел Settings > Bluetooth (roadmap, "Редизайн Settings" — правки по подразделам).
     Подключение — только сканом (тот же механизм, что и шаг PAIRING мастера PipBoy
     2000/3000, см. startPairingScan()/selectBluetoothSettingsPairingDevice() в
     MainActivity.kt) — интерфейс мастера заменяет собой старый ручной ввод MAC/UUID и
     кнопки Save/Connect/Disconnect целиком, не сосуществует с ним: тап по найденному
     устройству уже сохраняет MAC и переподключается сам (applyPairedDevice()). Свой фон
     (старый settings_menu_background_green) тоже убран — раздел живёт на общем тёмном
     фоне Settings, как Voice Commands/Map рядом. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tab_settings_bluetooth"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <!-- Свой [X] убран (roadmap, "Редизайн Settings", этап 26) — экран встроен как раздел
         бокового меню, переключение между разделами теперь делает сам сайдбар, отдельного
         локального закрытия не нужно. Заголовок "BLUETOOTH" тоже убран — дублировал
         название пункта в боковом меню. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tab_settings_aditional"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.975">

        <TextView
            android:id="@+id/textView_BLUETOOTH_Connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_marginTop="10dp"
            android:text="@string/bluetooth_status_disconnected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Текущий сопряжённый MAC — просто читаемая строка, нет аналога в мастере (тот
             сразу идёт дальше после выбора), но полезно видеть, какой корпус сохранён. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tab_settings_bluetooth_1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/textView_BLUETOOTH_Connection">

            <TextView
                android:id="@+id/textView_MACAddress"
                style="@style/CNDEFFRADButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bluetooth_field_mac_address"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_bluetooth_current_mac"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_bluetooth_current_mac"
                style="@style/SettingsButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center|right"
                android:text="@string/bluetooth_mac_not_set"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_MACAddress"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_bluetooth_pairing_status"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/wizard_pairing_scanning"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_tab_settings_bluetooth_1" />

        <!-- Высота — wrap_content, ограничена сверху местом до Rescan (та же логика, что у
             scroll_wizard_pairing_devices в мастере): короткий список не растягивается,
             длинный сам скроллится. -->
        <ScrollView
            android:id="@+id/scroll_bluetooth_pairing_devices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
            android:scrollbars="vertical"
            android:verticalScrollbarPosition="left"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_bluetooth_pairing_status"
            app:layout_constraintVertical_bias="0.0">

            <LinearLayout
                android:id="@+id/layout_bluetooth_pairing_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- top_toBottomOf списка + marginTop 10dp — тот же отступ "кнопка сразу под
             текстом", что у Import Bundle/Import Model (Map/Voice Commands), а не
             приколоченная к низу панели позиция (та не зависела от того, насколько
             короткий список реально занял места). Список сам капается constrainedHeight
             (см. ScrollView выше) — для длинного списка кнопка окажется у низа панели, как
             и раньше, для короткого — сразу под последним найденным устройством. -->
        <Button
            android:id="@+id/btn_bluetooth_rescan"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/wizard_pairing_rescan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scroll_bluetooth_pairing_devices" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

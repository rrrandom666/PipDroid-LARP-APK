                app:srcCompat="@drawable/hp_center" />

            <TextView
                android:id="@+id/tv_tab_status_cnd_pipboy_head_hp_crippled"
                style="@style/TextStyleCRIPPLED"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:text="@string/stats_cnd_status_crippled"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="78:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="0.52"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"

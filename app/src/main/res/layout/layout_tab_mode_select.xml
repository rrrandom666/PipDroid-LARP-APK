<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_mode_select"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/pip_background_darker">

    <!-- 96%-вставка + тонкие линии сверху/снизу — тот же приём, что у дисклеймера
         (layout_tab_tutorial_base.xml, roadmap "Косметические правки мастера"), общая
         рамка для экранов 1-5 мастера. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mode_select_frame"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <ImageView
            android:id="@+id/img_mode_select_line_top"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <ImageView
            android:id="@+id/img_mode_select_line_bottom"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <!-- Список режимов — тот же переиспользуемый паттерн, что у Perks (RecyclerView +
             описание справа, layout_tab_stats_perks.xml, roadmap "Косметические правки
             мастера"), вместо трёх отдельных кнопок. Тап — только показывает описание
             справа, не выбирает режим сразу (isSelected — какой пункт сейчас показан).
             Подтверждение — отдельная кнопка btn_mode_select_confirm под текстом описания,
             не в этом списке (путала пользователя вперемешку с режимами). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_mode_select"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:fadeScrollbars="false"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
            android:scrollbars="vertical"
            android:verticalScrollbarPosition="left"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintBottom_toTopOf="@id/img_mode_select_line_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_mode_select_line_top" />

        <!-- Фиксированная точка привязки кнопки [Выбрать] — не зависит от длины текста
             описания (roadmap, "Косметические правки мастера" — было "скачет" вслед за
             объёмом текста). Поднята вместе с текстом (см. ниже, текст теперь у верха, не
             по центру высоты). -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_mode_select_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.32" />

        <!-- Начинается на той же высоте, что и список слева (marginTop 16dp у списка +
             ~10dp свой отступ первого пункта списка, см. layout_recycler_selectable_list.xml
             — не по центру высоты колонки, как было раньше (roadmap, "Косметические правки
             мастера"). Только верхний констрейнт — высота wrap_content, растёт вниз от
             фиксированной точки, не центрируется между линиями рамки. -->
        <TextView
            android:id="@+id/tv_mode_select_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="start"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/img_mode_select_line_top"
            app:layout_constraintStart_toEndOf="@id/recycler_mode_select"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_mode_select_confirm"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:text="@string/mode_select_button"
            app:layout_constraintTop_toBottomOf="@id/guideline_mode_select_confirm"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

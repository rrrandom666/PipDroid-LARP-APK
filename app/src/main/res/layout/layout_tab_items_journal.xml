<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Journal (roadmap, этап 20) — личные записи игрока, текстовый ввод; голосовой
     (Vosk) — следующий отдельный шаг, кнопка-заглушка уже зарезервирована в попапе ввода
     (layout_journal_entry_popup.xml). Список слева/контент справа — тот же паттерн, что у
     ITEMS/Map/Clock (см. CLAUDE.md). Единый список слева (SidebarMenuAdapter) — первый пункт
     всегда "Новая запись" (payload=null в bindJournalListAdapter()), не отдельная кнопка. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_journal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_journal_menu_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:background="@color/pip_background_darker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_journal_entry_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Контент справа — взаимоисключающе: подсказка (либо "нет записей", либо "выбери
         запись" — какая из двух зависит от того, есть ли вообще записи, см.
         hideJournalEntryDetail() в MainActivity.kt) или карточка детали записи. Тот же
         паттерн, что tv_map_hint/layout_map_marker_detail. -->
    <TextView
        android:id="@+id/tv_journal_hint"
        android:fontFamily="@font/pipboy_mono"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:gravity="center"
        android:text="@string/journal_hint"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_journal_entry_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_journal_entry_detail_date"
            style="@style/CNDEFFRADButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ScrollView
            android:id="@+id/scroll_journal_entry_detail_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_journal_entry_detail_date"
            app:layout_constraintBottom_toTopOf="@id/btn_journal_entry_detail_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_journal_entry_detail_text"
                style="@style/CNDEFFRADButtonStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

        <Button
            android:id="@+id/btn_journal_entry_detail_edit"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/map_marker_detail_edit_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_journal_entry_detail_delete"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/map_marker_detail_delete_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_journal_entry_detail_edit" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/inc_layout_tab_items_journal_entry_popup"
        layout="@layout/layout_journal_entry_popup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_journal_menu_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.6" />

</androidx.constraintlayout.widget.ConstraintLayout>

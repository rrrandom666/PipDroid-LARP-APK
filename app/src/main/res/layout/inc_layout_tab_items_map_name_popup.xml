<?xml version="1.0" encoding="utf-8"?>
<!-- Ввод имени маркера сразу после тапа в режиме расстановки (Фаза E). В проекте нет
     AlertDialog вообще — небольшая GONE/VISIBLE подпанель поверх экрана карты, тот же
     приём, что у CND-попапа (layout_tab_stats_cnd_popup.xml), themed. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_map_name_popup"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@color/pip_background_darker"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintWidth_percent="0.6">

    <EditText
        android:id="@+id/et_marker_name_value"
        style="@style/SettingsButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/marker_name_popup_heading"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_marker_name_popup_cancel"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filter_cancel_button"
        app:layout_constraintTop_toBottomOf="@id/et_marker_name_value"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_marker_name_popup_save"
        style="@style/PipWizardButtonStyle"
        android:layout_width="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filter_save_button"
        app:layout_constraintTop_toBottomOf="@id/et_marker_name_value"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

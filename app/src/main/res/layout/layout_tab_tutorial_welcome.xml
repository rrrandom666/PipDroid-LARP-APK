<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:id="@+id/scroll_tutorial_welcome_main"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
        android:scrollbars="vertical"
        android:verticalScrollbarPosition="left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- fillViewport + высота fill_parent — текст центрируется по вертикали, пока
             помещается в экран; если не помещается (длинная локаль/маленький экран),
             ScrollView даёт скролл вместо обрезки. -->
        <TextView
            android:id="@+id/tv_tutorial_welcome"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:text="@string/disclaimer_text" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

                android:id="@+id/tv_tab_status_cnd_pipboy_left_leg_hp_crippled"
                style="@style/TextStyleCRIPPLED"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:text="@string/stats_cnd_status_crippled"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.8"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layout_tab_status_cnd_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/layout_tab_status_cnd_pipboy"
            app:layout_constraintStart_toStartOf="@id/layout_tab_status_cnd_pipboy"
            app:layout_constraintTop_toBottomOf="@id/layout_tab_status_cnd_pipboy"
            app:layout_constraintVertical_bias="0.4">

            <TextView
                android:id="@+id/tv_tab_status_cnd_name"
                style="@style/TextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/player_name" />

            <TextView
                android:id="@+id/tv_tab_status_cnd_name_level"
                style="@style/TextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_status_level_label" />

            <TextView
                android:id="@+id/tv_tab_status_cnd_name_level_value"
                style="@style/TextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_stats_status_lvl" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/inc_layout_tab_stats_cnd_popup"
        layout="@layout/layout_tab_stats_cnd_popup"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:visibility="gone"
        app:layout_constraintHeight_percent="0.975"
        app:layout_constraintWidth_percent="0.975"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
    <!-- Кнопки экрана выбора режима и мастера PipBoy (roadmap, косметические правки) —
         не трогает CNDEFFRADButtonStyle (используется по всему остальному приложению),
         отдельный стиль для новых экранов, которым нужны состояния активна/неактивна/
         нажата/выбрана. Фон, тинт (акцент текущей темы) и цвет текста для
         активна/неактивна/выбрана ставятся вручную кодом (см. currentWizardAccentColor(),
         setWizardButtonState() в MainActivity.kt) — на реальном устройстве StateListDrawable
         (state_activated, пустой catch-all item) не подхватывался, проверено, поэтому не
         полагаемся на состояния View. android:backgroundTint="@null" здесь не пишем
         намеренно — на этом AGP/AAPT2 @null в стиле не перекрывает тему (проверено), тинт
         всё равно выставляется кодом при каждом показе кнопки. Нажатие — системный ripple
         через foreground, это отдельный, независимо работающий механизм Android. -->
    <style name="PipWizardButtonStyle">
        <item name="android:background">@drawable/pip_wizard_button_bg_active</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/pip_button_text_dark</item>
        <item name="fontFamily">@font/pipboy_mono</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">16.0dip</item>
        <item name="android:paddingRight">16.0dip</item>
        <item name="android:paddingTop">4.0dip</item>
        <item name="android:paddingBottom">4.0dip</item>
        <item name="android:minWidth">0.0dip</item>
        <item name="android:minHeight">0.0dip</item>
        <!-- Единое место для высоты всех кнопок этого стиля (roadmap, "Редизайн экрана
             фильтра — UX-спецификация") — раньше каждый экран дублировал одинаковый
             android:layout_height="wrap_content" на каждой кнопке по отдельности; тот же
             результат, но теперь регулируется в одном месте. Инстансы, которым нужен другой
             размер (например +/- на SPECIAL/Skills, match_constraint под зону картинки),
             переопределяют этот атрибут у себя как обычно — инстанс всегда сильнее стиля. -->
        <item name="android:layout_height">wrap_content</item>
    </style>

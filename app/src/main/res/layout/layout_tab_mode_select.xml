<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_mode_select"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/pip_background_darker">

    <!-- 96%-вставка + тонкие линии сверху/снизу — тот же приём, что у дисклеймера
         (layout_tab_tutorial_base.xml, roadmap "Косметические правки мастера"), общая
         рамка для экранов 1-5 мастера. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mode_select_frame"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.96">

        <ImageView
            android:id="@+id/img_mode_select_line_top"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <ImageView
            android:id="@+id/img_mode_select_line_bottom"
            style="@style/ColorTintStyle"
            android:layout_width="0.0dip"
            android:layout_height="1.5dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/bottom_linking_line" />

        <!-- Три кнопки режима: тап только показывает описание справа (isSelected — какая
             сейчас показана), не выбирает режим сразу. Подтверждение — отдельная кнопка
             btn_mode_select_confirm под текстом описания, не в этом ряду (roadmap,
             косметические правки — путала пользователя в общем ряду с режимами). -->
        <LinearLayout
            android:id="@+id/layout_mode_select_buttons"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintBottom_toTopOf="@id/img_mode_select_line_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_mode_select_line_top">

            <Button
                android:id="@+id/btn_mode_select_phone"
                style="@style/PipWizardButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/mode_phone" />

            <Button
                android:id="@+id/btn_mode_select_pipboy2000"
                style="@style/PipWizardButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/mode_pipboy_2000" />

            <Button
                android:id="@+id/btn_mode_select_pipboy3000"
                style="@style/PipWizardButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_pipboy_3000" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mode_select_description"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="24dp"
            android:gravity="center_vertical"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/img_mode_select_line_top"
            app:layout_constraintBottom_toTopOf="@id/btn_mode_select_confirm"
            app:layout_constraintStart_toEndOf="@id/layout_mode_select_buttons"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_mode_select_confirm"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/mode_select_button"
            app:layout_constraintBottom_toTopOf="@id/img_mode_select_line_bottom"
            app:layout_constraintStart_toEndOf="@id/layout_mode_select_buttons" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PipDroid" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Окно всегда чёрное, не зависит от системной светлой/тёмной темы (DayNight) —
             иначе на светлой системной теме белый фон окна просвечивает по краям, когда
             рабочая область меньше экрана (roadmap, UX-спецификация мастера PipBoy). -->
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.PipDroid.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.PipDroid.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.PipDroid.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
<?xml version="1.0" encoding="utf-8"?>
<!-- ITEMS/Clock/Секундомер (roadmap, "Часы — UX-спецификация") — старт/пауза/сброс, без
     кругов. Переиспользует строки Старт/Пауза/Продолжить/Сброс из Таймера (тот же смысл,
     дублировать не нужно). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_items_clock_stopwatch"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <TextView
        android:id="@+id/tv_clock_stopwatch_elapsed"
        style="@style/ClockStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="64.0dip"
        android:text="00:00:00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_clock_stopwatch_buttons"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.4" />

    <LinearLayout
        android:id="@+id/layout_clock_stopwatch_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_clock_stopwatch_elapsed"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_clock_stopwatch_start_pause"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/clock_timer_start" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_clock_stopwatch_reset"
            style="@style/PipWizardButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_timer_reset" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

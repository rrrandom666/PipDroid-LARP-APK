<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Одна переиспользуемая страница на все 7 экранов тьюториала (roadmap, этап 25) —
         содержимое подставляется кодом (MainActivity.showTutorialPage()) из массива строк,
         а не отдельным layout-файлом на каждую страницу, как было у легаси Whatsnew/Stats/
         Items/Data/Settings. Структура — точная копия layout_tab_tutorial_welcome.xml. -->
    <ScrollView
        android:id="@+id/scroll_tutorial_page_main"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/scrollbar_custom_green"
        android:scrollbars="vertical"
        android:verticalScrollbarPosition="left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_tutorial_page"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fontFamily="@font/pipboy_mono"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="15dp"
            tools:text="@string/tutorial_page_whatsnew" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

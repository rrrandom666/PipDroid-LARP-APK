            <ImageView
                android:id="@+id/img_tab_status_cnd_pipboy_right_arm_hp"
                style="@style/ColorTintStyle"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.3"
                app:srcCompat="@drawable/hp_right" />

            <TextView
                android:id="@+id/tv_tab_status_cnd_pipboy_right_arm_hp_crippled"
                style="@style/TextStyleCRIPPLED"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:text="@string/stats_cnd_status_crippled"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.3"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_tab_status_cnd_pipboy_right_leg_hp"
                style="@style/ColorTintStyle"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.8"
                app:srcCompat="@drawable/hp_right" />

            <TextView
                android:id="@+id/tv_tab_status_cnd_pipboy_right_leg_hp_crippled"
                style="@style/TextStyleCRIPPLED"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:text="@string/stats_cnd_status_crippled"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.8"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_tab_status_cnd_pipboy_left_leg_hp"
                style="@style/ColorTintStyle"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:20"
                app:layout_constraintHeight_percent="0.06"
                app:layout_constraintHorizontal_bias="0.0"
